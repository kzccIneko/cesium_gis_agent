# mcp/ 下只有 custom/ 是自研代码，需入库；
# playwright-report/ 与 test-results/ 是运行产物，保持忽略。
# 注意：不能写 mcp/，否则父目录被排除后子目录无法再被 re-include。
mcp/*
!mcp/README.md
!mcp/custom/

# ========================
#  临时文件
# ========================
*.tmp
*.log
cesium_old/新建文本文档.txt

# ========================
#  LLM 权重（GGUF）—— 体积 3GB 级，禁止入库
#  下载方式见 IMPROVEMENT_PLAN.md 3.5.2
# ========================
models/llm/
*.gguf
*.gguf.part

# 训练权重与数据：体积过大，禁止入库
# 训练脚本（根目录 *_train.py、generate_*_data.py）与配置 json 已入库，
# 权重可由脚本重新生成
/models/**
!/models/terrain_morphology/
!/models/terrain_morphology/*.json

# 外部数据集仓库（数千文件、含 5MB+ 附件）
earthscape/

# 运行时数据
backend/.data/

# LoRA 训练产物：只忽略权重文件（61MB+），评测结果 JSON 要入库作为数字来源
bench/lora_out/**/*.safetensors
bench/lora_out/**/*.bin
bench/lora_out/**/optimizer.pt

# 训练数据与缓存（体积大，可由脚本重新生成）
bench/sft_data/*.json.bak
# v2 训练数据由 bench/build_sft_data_v2.py 确定性生成（random.seed 固定），
# 30MB 全部可复现，不入库以免仓库膨胀。要复现：python bench/build_sft_data_v2.py
bench/sft_data_v2/

# LoRA 训练副产物：tokenizer 副本 20MB、PEFT 自动生成的模型卡
# （训练配置在 adapter_config.json 里，评测数字在 eval_result.json 里，两者入库）
bench/lora_out/**/tokenizer.json
bench/lora_out/**/tokenizer_config.json
bench/lora_out/**/chat_template.jinja
bench/lora_out/**/README.md
bench/lora_out/_smoke*/

# 云端训练产物打包（约 120 MB）与 ModelScope 权重缓存：
# 都可由 bench/cloud_train.sh 重新生成，不入库。评测数字在
# lora_out/*/eval_result.json 里，那个要入库作为数字来源。
bench/geoagent_lora.tar.gz
bench/.ms_cache/

# ========================
#  本地开发环境（第三方二进制，非源码）
#  JDK / Tomcat / GeoServer / 各类安装包，约 250 MB、1600+ 文件。
#  其中多个文件超过 GitHub 100 MB 单文件上限，因此不入库；
#  需要运行前端时请自备环境，见 README「已知限制」。
# ========================
envirment/
